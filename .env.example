# 数据源配置
# 可选值: tushare / legacy
DATA_SOURCE=legacy

# Tushare Token（使用 tushare 数据源时必填）
# 注册地址: https://tushare.pro/register
# TUSHARE_TOKEN=your_token_here

# DeepSeek API 配置（AI 分析功能）
# 注册地址: https://platform.deepseek.com
# DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Vigil 后端监控（未设 TOKEN 则跳过）
VIGIL_TOKEN=
VIGIL_SERVER_URL=https://pyflow.icu/vigil-ingest
# VIGIL_ENDPOINT=https://pyflow.icu/vigil-ingest/ingest/v1/events
VIGIL_SAMPLE_RATE=1.0
